+        updateState {
+            it.copy(
+                email = email,
+                emailError = null
+            )
+        }
+        _registerErrorState.value = null
+    }
+
+    override fun onPasswordUpdated(password: String) {
+        updateState {
+            it.copy(
+                password = password,
+                passwordError = null
+            )
+        }
+        _registerErrorState.value = null
+    }
+
